# Copy this file to .env.local for local development
# Nothing here is required — the portfolio is fully static and the contact
# form sends client-side via EmailJS, whose public key lives in the bundle
# by design. There is no server-side mail backend and no API route.

# Overrides the canonical URL used for OG/Twitter image resolution.
# Defaults to https://rindrittelaku.dev — see app/layout.tsx
# NEXT_PUBLIC_SITE_URL=https://your-domain.dev
